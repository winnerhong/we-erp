# Supabase 프로젝트 설정 (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# 서버 전용 (RLS 우회 — 절대 클라이언트 번들/깃에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 앱 URL (선택)
NEXT_PUBLIC_APP_URL=http://localhost:1100

# Phase 1 영수증 OCR — Claude vision (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# OCR 모델 (선택, 기본 claude-opus-4-8). 비용 절감 시 claude-sonnet-4-6 / claude-haiku-4-5
ERP_OCR_MODEL=

# (선택) winner-kids 거래처 가져오기 — 이벤트 Supabase 읽기용
WKS_SUPABASE_URL=
WKS_SUPABASE_SERVICE_KEY=
# 자동 동기화 크론 보호용 시크릿 (Vercel Cron이 Bearer로 호출). 배포 시 설정.
CRON_SECRET=
